[
    {
        "name": "personal_access_token",
        "type": "password",
        "label": "Personal access token",
        "required": true,
        "editable": true,
        "help": "Token that reads the projects of the Searcherries account that created it. Every plan can connect: free accounts read projects, search performance, AI traffic and the action plan; AI answers, competitors and citations need Starter or Pro (an active trial counts). You can obtain your personal access token on the [MCP page](https://app.searcherries.com/mcp) in your Searcherries account: open the **Other clients** tab, click **Create token** and copy the token, which is shown once. Tokens created for an MCP client work too. Revoking a token on that page disconnects it here as well."
    }
]
