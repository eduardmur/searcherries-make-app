[
    {
        "name": "project",
        "type": "select",
        "label": "Project",
        "required": true,
        "options": "rpc://rpcProjects",
        "help": "The Searcherries project to read. The list shows the projects of the account that created the token."
    },
    {
        "name": "source",
        "type": "select",
        "label": "Source",
        "default": "google",
        "options": [
            {
                "label": "Google Search Console",
                "value": "google"
            },
            {
                "label": "Bing Webmaster Tools",
                "value": "bing"
            }
        ],
        "help": "Connected search source to read. If left empty, `google` is used."
    },
    {
        "name": "period",
        "type": "select",
        "label": "Window",
        "default": "30d",
        "options": [
            {
                "label": "Last 30 days",
                "value": "30d"
            },
            {
                "label": "Last 90 days",
                "value": "90d"
            },
            {
                "label": "Last 365 days",
                "value": "365d"
            }
        ],
        "help": "Rolling window of the stored snapshot, ending on the collection day. If left empty, `30d` is used."
    },
    {
        "name": "dataset",
        "type": "select",
        "label": "Dataset",
        "default": "summary",
        "options": [
            {
                "label": "Summary: totals, top-10 lists and counts",
                "value": "summary"
            },
            {
                "label": "Opportunities: high impressions, low CTR, long tail",
                "value": "opportunities"
            },
            {
                "label": "Trends: growing and falling",
                "value": "trends"
            }
        ],
        "help": "Which stored data to return. The lists of queries, pages and countries, the question-shaped queries, the daily series and the monthly history are rows: use the **List search performance rows** module for them. When the source or window has no stored data, the output says `available: false` and `reason` explains why. If left empty, `summary` is used."
    },
    {
        "name": "rows_per_list",
        "type": "uinteger",
        "label": "Rows per list",
        "validate": {
            "min": 1,
            "max": 100
        },
        "help": "Maximum rows in each list of the `opportunities` and `trends` datasets, `1` to `100`. If left empty, `25` rows per list are returned."
    }
]
