{
    "url": "/projects/{{parameters.project}}/search-performance",
    "method": "GET",
    "qs": {
        "source": "{{ifempty(parameters.source, 'google')}}",
        "period": "{{ifempty(parameters.period, '30d')}}",
        "dataset": "{{ifempty(parameters.dataset, 'summary')}}",
        "limit": "{{ifempty(parameters.rows_per_list, undefined)}}"
    },
    "response": {
        "output": "{{body}}"
    }
}
