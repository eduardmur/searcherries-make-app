{
    "url": "/projects/{{parameters.project}}/ai-traffic",
    "method": "GET",
    "qs": {
        "period": "{{ifempty(parameters.period, '30d')}}",
        "dataset": "{{ifempty(parameters.dataset, 'summary')}}",
        "source": "{{ifempty(parameters.source, undefined)}}",
        "path_contains": "{{ifempty(parameters.path_contains, undefined)}}",
        "limit": "{{ifempty(parameters.limit, undefined)}}",
        "offset": "{{ifempty(parameters.offset, undefined)}}"
    },
    "response": {
        "output": "{{body}}"
    }
}
