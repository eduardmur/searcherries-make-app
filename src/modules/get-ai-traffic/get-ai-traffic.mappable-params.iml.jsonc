[
    {
        "name": "project",
        "type": "select",
        "label": "Project",
        "required": true,
        "options": "rpc://rpcProjects",
        "help": "The Searcherries project to read. The list shows the projects of the account that created the token."
    },
    {
        "name": "period",
        "type": "select",
        "label": "Window",
        "default": "30d",
        "options": [
            {
                "label": "Last 30 days",
                "value": "30d"
            },
            {
                "label": "Last 90 days",
                "value": "90d"
            },
            {
                "label": "Last 365 days",
                "value": "365d"
            }
        ],
        "help": "Rolling window of the stored GA4 snapshot, ending on the collection day. If left empty, `30d` is used."
    }
]
