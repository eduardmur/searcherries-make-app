{
    "url": "/projects/{{parameters.project}}/competitors",
    "method": "GET",
    "qs": {
        "dataset": "detail",
        "competitor": "{{parameters.competitor}}",
        "period": "{{ifempty(parameters.period, undefined)}}"
    },
    "response": {
        // The API answers 200 with `found: false` and a `reason` when no tracked brand matches
        // the name; that is a result, not an error, so scenarios can filter on Found.
        "output": "{{body}}"
    }
}
